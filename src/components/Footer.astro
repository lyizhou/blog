---
import Icon from './Icon.astro';

const currentYear = new Date().getFullYear();
---

<footer>
	<div class="group">
		<p>
			Built with <a href="https://astro.build/">Astro</a>
			<Icon icon="rocket-launch" size="1.2em" />
		</p>
		<p>&copy; {currentYear} lyizhou</p>
	</div>
	<p class="socials">
		<a href="https://x.com/yiouliu148574">X</a>
		<a href="https://github.com/lyizhou">GitHub</a>
		<a href="mailto:yiouliu2333@gmail.com">Gmail</a>
	</p>
</footer>
<style>
	footer {
		display: flex;
		flex-direction: column;
		gap: 3rem;
		align-items: center;
		padding: 2.5rem 5rem;
		background-color: var(--gray-999);
		border-top: 1px solid var(--gray-800);
	}

	.group {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		color: var(--gray-400);
		font-size: var(--text-sm);
		text-align: center;
	}

	.group a {
		color: var(--accent-regular);
		text-decoration: none;
	}

	.socials {
		display: flex;
		gap: 2rem;
		font-size: var(--text-sm);
	}

	.socials a {
		color: var(--gray-400);
		text-decoration: none;
		transition: color var(--theme-transition);
	}

	.socials a:hover {
		color: var(--accent-regular);
	}

	@media (min-width: 50em) {
		footer {
			flex-direction: row;
			justify-content: space-between;
		}

		.group {
			flex-direction: row;
			gap: 1.5rem;
			text-align: left;
		}
	}
</style>
