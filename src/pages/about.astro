---
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About | lyizhou" description="关于 lyizhou —— 量化研究者与系统开发者">
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="About"
				tagline="记录技术探索与量化研究的旅程。"
			/>

			<section>
				<h2 class="section-title">Background</h2>
				<div class="content">
					<p>
						量化研究者与系统开发者。关注系统化交易策略的研究与落地，以及支撑这一切的技术基础设施。
					</p>
					<p>
						平时花大量时间在数据处理、策略回测和实盘执行系统上，同时也折腾各种网络与运维问题——这个博客就是记录这些过程的地方。
					</p>
					<p>
						写作是为了整理思路，也为了给遇到同类问题的人留一个参考。
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">研究方向</h2>
				<div class="content">
					<p>系统化交易策略 · 因子研究 · 实盘执行系统 · 量化基础设施</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">技术栈</h2>
				<div class="content">
					<p>Python · Linux · Tailscale · WireGuard · Astro · Obsidian · Cloudflare</p>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}
</style>
