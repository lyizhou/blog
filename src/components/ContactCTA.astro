---
import CallToAction from './CallToAction.astro';
import Icon from './Icon.astro';
---

<aside>
	<h2>有什么想聊的？</h2>
	<div class="actions">
		<CallToAction href="mailto:yiouliu2333@gmail.com">
			发邮件给我
			<Icon icon="paper-plane-tilt" size="1.2em" />
		</CallToAction>
		<p class="email">
			Gmail:
			<a href="mailto:yiouliu2333@gmail.com">yiouliu2333@gmail.com</a>
		</p>
	</div>
</aside>

<style>
	aside {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 3rem;
		border-top: 1px solid var(--gray-800);
		border-bottom: 1px solid var(--gray-800);
		padding: 5rem 1.5rem;
		background-color: var(--gray-999_40);
		box-shadow: var(--shadow-sm);
	}

	.actions {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	h2 {
		font-size: var(--text-xl);
		text-align: center;
		max-width: 15ch;
	}

	.email {
		margin: 0;
		color: var(--gray-300);
		font-size: var(--text-sm);
		text-align: center;
	}

	.email a {
		color: var(--accent-regular);
		text-decoration: none;
	}

	.email a:hover,
	.email a:focus {
		text-decoration: underline;
	}

	@media (min-width: 50em) {
		aside {
			padding: 7.5rem;
			flex-direction: row;
			flex-wrap: wrap;
			justify-content: space-between;
		}

		h2 {
			font-size: var(--text-3xl);
			text-align: left;
		}

		.actions {
			align-items: flex-start;
		}

		.email {
			text-align: left;
		}
	}
</style>
